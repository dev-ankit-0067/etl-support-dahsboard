# Application
APP_ENV=production
LOG_LEVEL=INFO
API_PREFIX=/api
CORS_ALLOW_ORIGINS=["https://your-dashboard.example.com"]

# AWS - default credential chain is used when these are unset (recommended in EKS/ECS via IRSA / task roles)
AWS_REGION=us-east-1
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# boto3 retry / timeouts
BOTO_MAX_ATTEMPTS=6
BOTO_RETRY_MODE=standard
BOTO_CONNECT_TIMEOUT=5
BOTO_READ_TIMEOUT=30

# Cache TTLs (seconds)
CACHE_TTL_SHORT=30
CACHE_TTL_MEDIUM=300
CACHE_TTL_LONG=1800

# Domain filters
GLUE_JOB_NAME_FILTER=
COST_EXPLORER_TAG_KEY=CostCenter
SLA_BREACH_MINUTES=60

# Project dropdown tag filter: PROJECT_TAG_KEY is the resource tag key (case-sensitive),
# PROJECT_VALUES is the comma-separated list of selectable values ("all" is added automatically).
# These are overridden by the remote (S3) config document when CONFIG_S3_BUCKET/KEY are set.
PROJECT_TAG_KEY=project
# PROJECT_VALUES=poc,prod,analytics

# Remote (S3) runtime configuration — optional JSON document that overrides env-based
# settings at runtime (incident provider, project tag values, per-project S3 log paths).
# The app re-fetches it every CONFIG_REFRESH_SECONDS (default 60) and falls back to env
# values when absent/unreachable. See config.example.json for the schema.
# CONFIG_S3_BUCKET=my-config-bucket
# CONFIG_S3_KEY=opsguardian/config.json
# CONFIG_REFRESH_SECONDS=60

# EMR log groups (CloudWatch). Set EMR_LOG_GROUP to the log group holding your
# EMR-on-EC2 logs; EMR_SERVERLESS_LOG_GROUP defaults to /aws/emr-serverless.
# EMR_LOG_GROUP=/aws/emr/containers
# EMR_SERVERLESS_LOG_GROUP=/aws/emr-serverless

# Custom S3 log source. Logs at s3://<bucket>/<project>/<run-id>.log — the S3 tab in
# Executive Overview lists these and the agent can analyse them. Requires s3:GetObject/ListBucket.
# Per-project prefixes can instead be configured in the remote config document
# ("s3LogPath" per project value; the walker descends through sub-folders to the files).
# S3_LOG_BUCKET=my-etl-logs-bucket

# SSM Incident Manager
# SSM_RESPONSE_PLAN_ARN=arn:aws:ssm-incidents::123456789012:response-plan/etl-prod

# Incident provider selection — which ticketing backend to use for incidents/RCA.
# The backend talks to it via an in-process MCP server (stdio). One of: jira | servicenow.
# Overridable at runtime via "incidentProvider" in the remote config document.
INCIDENT_PROVIDER=jira

# Jira Integration (used when INCIDENT_PROVIDER=jira)
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=your@email.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=SCRUM
# JIRA_ISSUE_TYPE=Bug
# USE_JIRA_INCIDENTS=true

# ServiceNow Integration (used when INCIDENT_PROVIDER=servicenow) — Table API + basic auth
# SERVICENOW_INSTANCE=https://devXXXXX.service-now.com
# SERVICENOW_USER=your_service_account
# SERVICENOW_PASSWORD=your_password_or_api_token
# SERVICENOW_TABLE=incident
# Incident field used to filter by the selected project value (empty disables filtering)
# SERVICENOW_PROJECT_FIELD=u_project

# LangChain agents — HuggingFace Inference API
HUGGINGFACE_API_TOKEN=hf_...
# Override the default model if needed (must support tool/function calling).
# Default: Qwen/Qwen2.5-72B-Instruct. NOTE: mistralai/Mistral-7B-Instruct-v0.3
# is NOT served as a chat model on the Inference API (model_not_supported).
# HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct

# Gunicorn worker timeout (s). The AI-agent path (LLM + log fetch + ticket) can
# exceed the 60s default; raise it to avoid 502/504s mid-request.
# GUNICORN_TIMEOUT=300
